#include <iostream>
using namespace std;

int main()
{
    int n = 5;

    double x[5] = {1, 4, 6, 7, 12};
    double y[5] = {-3, -5, 7, 14, 15};

    double a[5];

    for (int i = 0; i < n; i++)
        a[i] = y[i];

    for (int j = 1; j < n; j++)
    {
        for (int i = n - 1; i >= j; i--)
        {
            a[i] = (a[i] - a[i - 1]) / (x[i] - x[i - j]);
        }
    }

    cout << "x    y    a" << endl;

    for (int i = 0; i < n; i++)
    {
        cout << x[i] << "    "
             << y[i] << "    "
             << a[i] << endl;
    }

    double X;
    cout << "\nВведите x: ";
    cin >> X;

    double P = a[n - 1];

    for (int i = n - 2; i >= 0; i--)
    {
        P = a[i] + (X - x[i]) * P;
    }

    cout << "Интерполированное значение: " << P << endl;

    return 0;
}
